{
  "name": "pureview",
  "version": "1.0.0",
  "private": true,
  "description": "PureView - Personal Video Library (web)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:server\" \"vite --mode mysql\"",
    "dev:browser": "vite",
    "server": "tsx watch server/index.ts",
    "start": "vite build --mode mysql --outDir dist-mysql && tsx server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
